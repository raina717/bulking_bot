[Unit]
Description=Telegram Bulking Bot (Claude + Hermes)
After=network.target ollama.service

[Service]
Type=simple
User=YOUR_VPS_USERNAME
WorkingDirectory=/home/YOUR_VPS_USERNAME/bulking-bot
ExecStart=/home/YOUR_VPS_USERNAME/bulking-bot/venv/bin/python bot.py
Restart=always
RestartSec=5
EnvironmentFile=/home/YOUR_VPS_USERNAME/bulking-bot/.env

[Install]
WantedBy=multi-user.target
