# --- Telegram ---
TELEGRAM_BOT_TOKEN=123456:isi-token-dari-BotFather
# Telegram user ID kamu sendiri, biar bot cuma respon ke kamu.
# Cara dapetin: chat @userinfobot di Telegram, dia bakal kasih ID kamu.
TELEGRAM_OWNER_ID=123456789

# --- Claude (agent utama) ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx
CLAUDE_MODEL=claude-sonnet-5

# --- Hermes (agent fallback, self-hosted via Ollama di VPS) ---
OLLAMA_HOST=http://127.0.0.1:11434
# Nama model persis sesuai hasil `ollama list` setelah kamu pull, misal:
# hermes3, nous-hermes2, adrienbrault/nous-hermes2theta-llama3-8b, dll.
HERMES_MODEL=hermes3

# --- Data profil disimpan di file lokal ---
PROFILE_FILE=profile.json

# --- Log harian (berat badan, kalori olahraga dari Huawei Health, makanan) ---
LOG_FILE=logs.json
# Timezone buat nentuin batas "hari ini" (format IANA), biar log harian pas.
TIMEZONE=Asia/Jakarta
