# --- Telegram Configuration ---
TELEGRAM_BOT_TOKEN=123456:your-bot-token-from-BotFather
# Your personal Telegram User ID to ensure the bot only responds to you.
# To get this: chat with @userinfobot on Telegram, and it will return your ID.
TELEGRAM_OWNER_ID=123456789

# --- AI Configuration ---
# Gemini API Key (Required for Image processing /makan)
GEMINI_API_KEY=your-gemini-api-key

# Groq API Key (Required for Text chat, /saran, and text /makan)
GROQ_API_KEY=your-groq-api-key

# --- Local Data Storage ---
# File to store your personal profile and targets
PROFILE_FILE=profile.json

# File to store daily logs (weight, exercise, meals)
LOG_FILE=logs.json
# Timezone to determine the start/end of "today" (IANA format)
TIMEZONE=Asia/Jakarta
